# AI Skin Scanner Environment Variables
# Copy this file to .env.local for your local development configuration.

# Supabase Project URL & Anon Key (Client Side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: ANTHROPIC_API_KEY is stored strictly inside Supabase Secrets for the
# 'analyze-skin' edge function, and is NEVER exposed to the client or browser.
# To configure in Supabase CLI:
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
